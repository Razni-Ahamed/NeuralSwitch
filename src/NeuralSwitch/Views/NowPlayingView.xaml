<UserControl x:Class="NeuralSwitch.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralSwitch.ViewModels"
             xmlns:core="clr-namespace:NeuralSwitch.Core.Engine;assembly=NeuralSwitch.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36" MaxWidth="900">

            <!-- Title, and which game when several are running -->
            <DockPanel Margin="0,0,0,20">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding RunningGames}" VerticalAlignment="Center"
                              Visibility="{Binding HasSeveralRunning, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RunningGame}">
                            <Button Style="{StaticResource ChoiceCard}" Margin="6,0,0,0" Padding="0"
                                    Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="Control this game">
                                <Button.Tag>
                                    <MultiBinding Converter="{StaticResource Equals}">
                                        <Binding Path="Pid" />
                                        <Binding Path="DataContext.ConnectedPid" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Button.Tag>
                                <TextBlock Text="{Binding Title}" Margin="0,0,24,0" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource PageTitle}" Text="Now playing" />
            </DockPanel>

            <!-- The game and the switch -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Surface2}" VerticalAlignment="Top">
                        <Grid>
                            <!-- A controller glyph until the game's own icon is known. -->
                            <TextBlock Text="&#xE7FC;" FontSize="28" Foreground="{StaticResource Faint}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameIcon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding GameIcon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="GameTitle" />
                        <TextBlock Text="{Binding GameSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                <Setter Property="Background" Value="{StaticResource InfoSoft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="ComparisonOff">
                                                <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Faint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                        <Setter Property="Fill" Value="{StaticResource Info}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ComparisonOff">
                                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="StatusTitle" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PowerSwitch}" Command="{Binding ToggleCommand}" Tag="{Binding IsEnabled}"
                                AutomationProperties.AutomationId="PowerSwitch" AutomationProperties.Name="Neural Rendering on or off"
                                ToolTip="Turn Neural Rendering on or off" />
                        <TextBlock Text="{Binding PowerText}" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="PowerText" />
                    </StackPanel>

                    <!-- What is happening, in words -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource Surface2}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Try again" Command="{Binding RetryCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RetryButton"
                                    Visibility="{Binding Status, Converter={StaticResource PageVisible}, ConverterParameter=Failed}" />
                            <Button DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="Games" Margin="12,0,0,0"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Center" AutomationProperties.AutomationId="GoToGames"
                                    Visibility="{Binding Status, Converter={StaticResource PageVisible}, ConverterParameter=NotConnected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Go to Games" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}"
                                       VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Style -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding IsConnected}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Style" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                               Text="The model's three looks. Picking one also turns Neural Rendering on." />
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource ChoiceCard}" Margin="0,0,10,0" Command="{Binding StyleCommand}" CommandParameter="{x:Static core:NrStyle.Default}"
                                Tag="{Binding CurrentStyle, Converter={StaticResource Is}, ConverterParameter=Default}"
                                AutomationProperties.AutomationId="Style_Default" AutomationProperties.Name="Default style">
                            <StackPanel>
                                <TextBlock Text="Default" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,24,0" Text="The strongest effect: more contrast and deeper lighting." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChoiceCard}" Margin="5,0,5,0" Command="{Binding StyleCommand}" CommandParameter="{x:Static core:NrStyle.Natural}"
                                Tag="{Binding CurrentStyle, Converter={StaticResource Is}, ConverterParameter=Natural}"
                                AutomationProperties.AutomationId="Style_Natural" AutomationProperties.Name="Natural style">
                            <StackPanel>
                                <TextBlock Text="Natural" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,24,0" Text="Realistic light and materials, true to the game's own colours." />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChoiceCard}" Margin="10,0,0,0" Command="{Binding StyleCommand}" CommandParameter="{x:Static core:NrStyle.Cinematic}"
                                Tag="{Binding CurrentStyle, Converter={StaticResource Is}, ConverterParameter=Cinematic}"
                                AutomationProperties.AutomationId="Style_Cinematic" AutomationProperties.Name="Cinematic style">
                            <StackPanel>
                                <TextBlock Text="Cinematic" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,24,0" Text="Softer and film-like, with less shine." />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Intensity -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding IsConnected}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reset" Command="{Binding ResetIntensityCommand}"
                                ToolTip="Back to 1.00" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding IntensityText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,8,0" AutomationProperties.AutomationId="IntensityValue" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Intensity" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10" Text="How strongly the look is applied. It changes the picture, not the cost." />
                    <Slider Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding Intensity}" AutomationProperties.AutomationId="IntensitySlider" AutomationProperties.Name="Intensity" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="Subtle" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" Text="Normal" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" Text="Strong" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Numbers -->
            <UniformGrid Rows="1" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="FRAMES RENDERED" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text=" fps" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="NEURAL RENDERING COST" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding CostText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text=" ms per frame" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="HOTKEYS IN GAME" />
                        <TextBlock Margin="0,8,0,0" FontSize="13">
                            <Run Text="{Binding ToggleHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" on/off" Foreground="{StaticResource Muted}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="13">
                            <Run Text="{Binding StyleHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" next style" Foreground="{StaticResource Muted}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
