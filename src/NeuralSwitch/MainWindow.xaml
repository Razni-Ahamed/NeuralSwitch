<Window x:Class="NeuralSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NeuralSwitch.Views"
        Title="NeuralSwitch" Width="1100" Height="760" MinWidth="920" MinHeight="620"
        Icon="/Assets/NeuralSwitch.ico" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar ======================================================================================= -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="/Assets/NeuralSwitch.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NeuralSwitch" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="DLSS 5, switched live" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Connection, always in view -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Faint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="NO GAME CONNECTED" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="CONNECTED" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsConnected, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0"
                                   Visibility="{Binding IsConnected, Converter={StaticResource Visible}}">
                            <Run Text="Neural Rendering " /><Run Text="{Binding StatusTitle, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0">
                            <Run Text="{Binding ToggleHotkey, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text=" on/off" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="NowPlaying"
                            Tag="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=NowPlaying}"
                            AutomationProperties.AutomationId="Nav_NowPlaying" AutomationProperties.Name="Now playing">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,14,0" />
                            <TextBlock Text="Now playing" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Games"
                            Tag="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=Games}"
                            AutomationProperties.AutomationId="Nav_Games" AutomationProperties.Name="Games">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Margin="0,0,14,0" />
                            <TextBlock Text="Games" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Tag="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=Settings}"
                            AutomationProperties.AutomationId="Nav_Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,14,0" />
                            <TextBlock Text="Settings" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="About"
                            Tag="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=About}"
                            AutomationProperties.AutomationId="Nav_About" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,14,0" />
                            <TextBlock Text="About" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages ========================================================================================= -->
        <Grid Grid.Column="1">
            <views:NowPlayingView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=NowPlaying}" />
            <views:GamesView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Games}" />
            <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Settings}" />
            <views:AboutView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=About}" />

            <!-- Notification -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="460" CornerRadius="10" Padding="14,11,8,11"
                    BorderThickness="1" Visibility="{Binding HasMessage, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="Toast">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Surface2}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="7,5" Margin="8,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE946;" />
                                <Setter Property="Foreground" Value="{StaticResource Info}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageKind}" Value="Success">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MessageKind}" Value="Error">
                                        <Setter Property="Text" Value="&#xE783;" />
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18"
                               AutomationProperties.AutomationId="ToastText" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- A question, in the app's own style ============================================================ -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="{Binding IsAsking, Converter={StaticResource Visible}}"
              AutomationProperties.AutomationId="Question">
            <Border Style="{StaticResource Card}" MaxWidth="520" Padding="26,22" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource WarnSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="17" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding QuestionTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>
                    <TextBlock Text="{Binding QuestionText}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding QuestionDetail}" Style="{StaticResource Caption}" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="11.5" Visibility="{Binding QuestionDetail, Converter={StaticResource NotEmpty}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{Binding QuestionYes}" Command="{Binding AnswerYesCommand}" Margin="0,0,10,0" AutomationProperties.AutomationId="QuestionYes" />
                        <Button Content="{Binding QuestionNo}" Command="{Binding AnswerNoCommand}" Style="{StaticResource AccentButton}" Padding="20,8"
                                IsDefault="True" AutomationProperties.AutomationId="QuestionNo" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- First run: the caution, accepted before anything else ======================================== -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="{Binding NeedsCaution, Converter={StaticResource Visible}}"
              AutomationProperties.AutomationId="CautionOverlay">
            <Border Style="{StaticResource Card}" MaxWidth="600" Padding="30,26" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource WarnSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="20" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Before you start" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,16"
                               Text="NeuralSwitch is an unofficial, experimental tool. Please read this and accept it first." />

                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style TargetType="TextBlock" x:Key="Point" BasedOn="{StaticResource Caption}">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </ItemsControl.Resources>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Warn}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Point}" FontWeight="SemiBold"
                                       Text="Never use it in online or multiplayer games. Anti-cheat can permanently ban your account." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Foreground="{StaticResource Muted}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Point}"
                                       Text="It loads a third-party mod (OptiScaler-DLSS5) into the games you prepare, using an undocumented NVIDIA driver feature." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Muted}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Point}"
                                       Text="Games can crash or misbehave, and driver or game updates can break it. Back up your saves." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="13" Foreground="{StaticResource Muted}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Point}"
                                       Text="NVIDIA's model isn't included and is never downloaded. Only use a copy signed by NVIDIA." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource Muted}"
                                       Margin="0,2,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Point}"
                                       Text="It comes with no warranty. You use it at your own risk, and its authors aren't responsible for what happens to your games, accounts or PC." />
                        </DockPanel>
                    </ItemsControl>

                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,0,0,14" Command="{Binding OpenLinkCommand}"
                            CommandParameter="caution" AutomationProperties.AutomationId="CautionReadFull">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Read the full user caution" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <CheckBox IsChecked="{Binding CautionChecked}" AutomationProperties.AutomationId="CautionAccept">
                        <TextBlock Text="I have read and accept the user caution, and I use NeuralSwitch at my own risk." TextWrapping="Wrap" />
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Quit" Click="Quit_Click" Margin="0,0,10,0" Style="{StaticResource GhostButton}" AutomationProperties.AutomationId="CautionQuit" />
                        <Button Content="Continue" Style="{StaticResource AccentButton}" Padding="22,8" Command="{Binding AcceptCautionCommand}"
                                AutomationProperties.AutomationId="CautionContinue" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
