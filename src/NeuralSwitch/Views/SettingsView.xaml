<UserControl x:Class="NeuralSwitch.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:NeuralSwitch.Core.Engine;assembly=NeuralSwitch.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36" MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" Margin="0,0,0,20" />

            <!-- NVIDIA's model -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NVIDIA's model" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                               Text="nvngx_dlssnr.dll does the Neural Rendering. NeuralSwitch finds it where NVIDIA's driver downloads models, in the driver store and in your games, and only uses it without asking when it's signed by NVIDIA." />
                    <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,1,12,0" VerticalAlignment="Top" FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModelOk}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{Binding ModelTitle}" FontWeight="SemiBold" AutomationProperties.AutomationId="ModelTitle" />
                                <TextBlock Text="{Binding ModelDetail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Locate model…" Command="{Binding LocateModelCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="LocateModelButton" />
                        <Button Content="Search automatically" Command="{Binding UseAutomaticModelCommand}" Style="{StaticResource GhostButton}"
                                ToolTip="Forget the file you picked and search the usual places again" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Game folders -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddFolderCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Game folders" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,16,0" Text="Folders whose subfolders are games, such as C:\Games or steamapps\common." />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding LibraryFolders}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remove"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="No folders yet."
                               Visibility="{Binding LibraryFolders.Count, Converter={StaticResource PageVisible}, ConverterParameter=0}" />
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Hotkeys" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Text="They work while a game has focus, as long as NeuralSwitch is running (in the notification area is enough)." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Turn on or off" VerticalAlignment="Center" Width="140" />
                        <TextBlock Grid.Column="1" Text="Ctrl + Alt +" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="2" Width="52" MaxLength="1" TextAlignment="Center" FontWeight="SemiBold"
                                 Text="{Binding ToggleKeyText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ToggleKeyBox"
                                 AutomationProperties.Name="Letter for the on/off hotkey" />

                        <TextBlock Grid.Row="1" Text="Next style" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl + Alt +" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="0,10,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="2" Width="52" MaxLength="1" TextAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"
                                 Text="{Binding StyleKeyText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StyleKeyBox"
                                 AutomationProperties.Name="Letter for the next-style hotkey" />

                        <Button Grid.RowSpan="2" Grid.Column="3" Content="Apply" Command="{Binding ApplyHotkeysCommand}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="20,0,0,0" AutomationProperties.AutomationId="ApplyHotkeysButton" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Margin="0,0,8,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeysOk}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="HotkeyStatus" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Default style -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Newly prepared games start with" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Text="The style a game uses when you first turn Neural Rendering on. You can change it any time while playing." />
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource ChoiceCard}" Margin="0,0,8,0" Content="Default"
                                Command="{Binding DefaultStyleCommand}" CommandParameter="{x:Static core:NrStyle.Default}"
                                Tag="{Binding DefaultStyle, Converter={StaticResource Is}, ConverterParameter=Default}"
                                AutomationProperties.AutomationId="DefaultStyle_Default" />
                        <Button Style="{StaticResource ChoiceCard}" Margin="4,0,4,0" Content="Natural"
                                Command="{Binding DefaultStyleCommand}" CommandParameter="{x:Static core:NrStyle.Natural}"
                                Tag="{Binding DefaultStyle, Converter={StaticResource Is}, ConverterParameter=Natural}"
                                AutomationProperties.AutomationId="DefaultStyle_Natural" />
                        <Button Style="{StaticResource ChoiceCard}" Margin="8,0,0,0" Content="Cinematic"
                                Command="{Binding DefaultStyleCommand}" CommandParameter="{x:Static core:NrStyle.Cinematic}"
                                Tag="{Binding DefaultStyle, Converter={StaticResource Is}, ConverterParameter=Cinematic}"
                                AutomationProperties.AutomationId="DefaultStyle_Cinematic" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Background -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="When the window is closed" />
                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding CloseToTray}" AutomationProperties.AutomationId="CloseToTrayCheck">
                        <StackPanel>
                            <TextBlock Text="Keep running in the notification area" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="So the hotkeys keep working while you play. Quit from the tray icon's menu." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Engine -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenEngineFolderCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding EngineTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,16,0" Text="{Binding EngineDetail}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="4,16,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                    <Run Text="Settings are saved in " /><Run Text="{Binding SettingsFile, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
