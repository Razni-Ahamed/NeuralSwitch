<UserControl x:Class="NeuralSwitch.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeuralSwitch.ViewModels">
    <DockPanel Margin="36,30,36,24">

        <!-- Title and actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AddFolderCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="AddFolderButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RescanCommand}" AutomationProperties.AutomationId="RescanButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Games" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding GameCountText}" Margin="0,2,0,0" AutomationProperties.AutomationId="GameCount" />
            </StackPanel>
        </DockPanel>

        <!-- Library folders -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding LibraryFolders}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"
                            Padding="10,2,2,2" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Padding="6,3" Margin="4,0,0,0" ToolTip="Stop looking in this folder"
                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="Remove folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" Foreground="{StaticResource Muted}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- What is missing before games can be prepared -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarnSoft}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                Visibility="{Binding SetupWarning, Converter={StaticResource NotEmpty}}" AutomationProperties.AutomationId="SetupWarning">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,1,12,0"
                           VerticalAlignment="Top" />
                <Button DockPanel.Dock="Right" Content="Locate model…" Command="{Binding LocateModelCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LocateModelBanner" />
                <TextBlock Text="{Binding SetupWarning}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Nothing found -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="28"
                Visibility="{Binding Games.Count, Converter={StaticResource PageVisible}, ConverterParameter=0}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="36" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="No DLSS games found" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="420"
                           Text="Add the folder that holds your games, for example steamapps\common. Each folder inside it counts as one game, and games that ship DLSS appear here." />
            </StackPanel>
        </Border>

        <!-- The games -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameItem}">
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource Surface2}" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="&#xE7FC;" FontSize="22" Foreground="{StaticResource Faint}" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,2,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding DlssText, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="{StaticResource Faint}" />
                                        <Run Text="{Binding ExeName, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding BlockedReason}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" MaxWidth="460" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="11" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Surface2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateKind}" Value="Ready">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKind}" Value="Playing">
                                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKind}" Value="Blocked">
                                                    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="{Binding Name, StringFormat=GameState_{0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateKind}" Value="Playing">
                                                        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Padding="9,7" Margin="0,0,6,0" ToolTip="Open the game's folder"
                                            Command="{Binding DataContext.OpenGameFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Open folder"
                                            AutomationProperties.AutomationId="{Binding Name, StringFormat=OpenFolder_{0}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" />
                                    </Button>
                                    <Grid Width="104">
                                        <Button Content="Prepare" Style="{StaticResource AccentButton}"
                                                Command="{Binding DataContext.PrepareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding CanPrepare, Converter={StaticResource Visible}}"
                                                AutomationProperties.AutomationId="{Binding Name, StringFormat=Prepare_{0}}"
                                                ToolTip="Add the engine to this game's folder. The game starts as before until you switch Neural Rendering on." />
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding IsPrepared, Converter={StaticResource Visible}}"
                                                AutomationProperties.AutomationId="{Binding Name, StringFormat=Remove_{0}}"
                                                ToolTip="Take the engine out again. The folder ends up exactly as it was. Close the game first." />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
