<UserControl x:Class="NeuralSwitch.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A documentation link: an icon, a title and a line under it. -->
        <Style x:Key="DocLink" TargetType="Button" BasedOn="{StaticResource ChoiceCard}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Command" Value="{Binding OpenLinkCommand}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36" MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="About" Margin="0,0,0,20" />

            <Border Style="{StaticResource Card}" Padding="24">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/Assets/NeuralSwitch.png" Width="72" Height="72" Margin="0,0,20,0" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <TextBlock Text="NeuralSwitch" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,2,0,10" AutomationProperties.AutomationId="VersionText" />
                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Text}"
                                   Text="Turns DLSS 5 Neural Rendering on and off, and switches its style, while you play, in games that already support DLSS. The rendering itself is done inside the game by OptiScaler-DLSS5 and NVIDIA's model; NeuralSwitch prepares games and controls it live." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Documentation" Margin="4,24,0,10" />
            <UniformGrid Columns="2">
                <Button Style="{StaticResource DocLink}" CommandParameter="guide" Margin="0,0,6,8" AutomationProperties.AutomationId="Link_guide">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="User guide" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Setup, every message, troubleshooting" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DocLink}" CommandParameter="caution" Margin="6,0,0,8" AutomationProperties.AutomationId="Link_caution">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource Warn}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="User caution" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Risks, responsibilities, no warranty" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DocLink}" CommandParameter="license" Margin="0,0,6,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="License" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="GNU GPL version 3" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DocLink}" CommandParameter="notices" Margin="6,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="Third-party notices" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Components and their licenses" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DocLink}" CommandParameter="issues" Margin="0,0,6,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="Report a problem" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Open an issue on GitHub" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DocLink}" CommandParameter="repo" Margin="6,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="Project on GitHub" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Source, releases and updates" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Credits" Margin="4,16,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Text}">
                        <Run Text="OptiScaler" FontWeight="SemiBold" /><Run Text=" by cdozdil and the OptiScaler team: the engine." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Text}" Margin="0,6,0,0">
                        <Run Text="OptiScaler-DLSS5" FontWeight="SemiBold" /><Run Text=" by Skynizz, on Dagherbou's OptiScaler_DLSSNR: the Neural Rendering." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Text}" Margin="0,6,0,0">
                        <Run Text="RenoDX" FontWeight="SemiBold" /><Run Text=" by clshortfuse: the colour composition the engine uses." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource WarnSoft}" CornerRadius="12" Padding="18,14" Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,1,12,0"
                               VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Text}"
                               Text="NeuralSwitch is unofficial and not affiliated with NVIDIA or with any game publisher. It comes with no warranty, and you use it at your own risk. Never use it in online or multiplayer games. DLSS is a trademark of NVIDIA Corporation." />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
